# Copy to .env, fill in, then load it BEFORE launching Claude Code:
#   bash:        set -a; source .env; set +a
#   PowerShell:  Get-Content .env | % { if ($_ -match '^(?:export\s+)?(\w+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }
# Fine-grained PAT scoped to this one repo: Contents RW, Pull requests RW, Issues RW, Metadata R
GITHUB_PAT=
